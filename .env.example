# ---------------------------------------------------------------------------
# REQUIS
# ---------------------------------------------------------------------------

# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/togotransit_db?schema=public"

# Secret de signature des JWT
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# OPTIONNEL
# ---------------------------------------------------------------------------

# Adresse publique du site (liens des billets / QR codes, retour de paiement)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Assistant IA : sans clé, le chatbot répond par règles à partir de la base
OPENAI_API_KEY=

# E-mails (Resend)
RESEND_API_KEY=

# Paiement Mobile Money (PayGate) : valeurs à renseigner depuis le tableau de bord PayGate
PAYGATE_MERCHANT_ID=
PAYGATE_API_KEY=
PAYGATE_API_URL=
PAYGATE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# COMPTES DE DÉMONSTRATION (développement local uniquement)
# ---------------------------------------------------------------------------
# Mots de passe des comptes créés par prisma/seed.ts, et pré-remplis par les boutons
# « Accès développement » de la page de connexion (visibles seulement avec `npm run dev`).
# Laisser vide : le seed génère des mots de passe aléatoires et les affiche.
# Le préfixe NEXT_PUBLIC_ est requis pour que la page de connexion puisse les lire en
# développement. Ne définissez JAMAIS ces variables sur Vercel ni en production.
NEXT_PUBLIC_DEMO_PASSWORD_SUPERADMIN=
NEXT_PUBLIC_DEMO_PASSWORD_NAGODE=
NEXT_PUBLIC_DEMO_PASSWORD_SOLIM=
NEXT_PUBLIC_DEMO_PASSWORD_LK=
NEXT_PUBLIC_DEMO_PASSWORD_CHAUFFEUR=
NEXT_PUBLIC_DEMO_PASSWORD_VOYAGEUR=
