# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/togotransit_db?schema=public"

# OpenAI API Key (pour le chatbot)
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Vision Credentials (pour l'OCR)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/your/credentials.json

# DeepL API Key (pour la traduction)
# DEEPL_API_KEY=your_deepl_api_key_here

# PayGate (agrégateur Mobile Money Togo) — valeurs à renseigner depuis le dashboard PAYGATE PAYGATE_MERCHANT_ID= PAYGATE_API_KEY= PAYGATE_API_URL= PAYGATE_WEBHOOK_SECRET=

